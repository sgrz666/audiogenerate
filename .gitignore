# 模型权重（只保留 model/README.md）
model/*/
!model/README.md

# 数据音频、转写与标注表（仓库只保留数据集介绍与分包统计）
data/**/data/
data/**/*.wav
data/**/*.mp3
data/**/*.flac
data/**/*.m4a
data/**/*.txt
data/**/index.html
data/**/checksums.sha256
data/**/metadata/samples.*
data/**/metadata/questions.*

# 下载缓存、临时目录与凭据
.tmp/
.cache/
.hf_cache/
*.part
*bdcookie*
bdjar.txt
.note/

# 实验产出音频（体积大，仅保留清单/报告/统计）
audio/**/*.wav
audio/**/*.mp3
audio/**/*.flac
audio/**/*.m4a
P2_听评包/audio/
整理汇报/音频/**/*.wav
整理汇报/音频/**/*.mp3
results/**/*.wav
results/**/*.mp3

# 第三方仓库副本与虚拟环境（可复现，不入库）
repos/
envs/
logs/

# 编辑器残留的备份文件
*.bak
*.bak_*
*.py.bak*

# Python 缓存
__pycache__/
*.py[cod]

# 系统与编辑器
.DS_Store
Thumbs.db
*.swp
